{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@modest/shared": ["packages/shared/src/index.js"],
      "@modest/db": ["packages/db/src/index.js"],
      "@modest/config-engine": ["packages/config-engine/src/index.js"],
      "@modest/ai": ["packages/ai/src/index.js"],
      "@modest/i18n": ["packages/i18n/locales/en/index.js"],
      "@modest/cards": ["packages/cards/src/index.js"],
      "@modest/game-data": ["packages/game-data/src/index.js"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
