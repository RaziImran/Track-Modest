{
  "name": "@modest/bot",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "register-commands": "tsx scripts/register-commands.ts"
  },
  "dependencies": {
    "@discordjs/rest": "2.4.0",
    "@modest/config-engine": "workspace:*",
    "@modest/db": "workspace:*",
    "@modest/shared": "workspace:*",
    "bullmq": "5.81.6",
    "discord.js": "14.16.3",
    "prom-client": "15.1.3",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@vitest/coverage-v8": "2.1.4",
    "vitest": "2.1.4"
  }
}
