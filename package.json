{
  "name": "track-modest",
  "private": true,
  "description": "Track Modest — all-in-one Discord bot platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "register-commands": "turbo run register-commands --filter=@modest/bot"
  },
  "devDependencies": {
    "turbo": "2.4.4",
    "typescript": "5.7.3",
    "eslint": "9.19.0",
    "prettier": "3.4.2",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "eslint-config-prettier": "9.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "private"
  }
}
